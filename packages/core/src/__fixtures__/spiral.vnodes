{
  "format": "vector-nodes",
  "version": "1.0",
  "metadata": {
    "name": "Spiral",
    "author": "Sergey Chernyshev",
    "description": "A simple spiral of points fed to the output."
  },
  "parameters": [{ "id": "turns", "type": "Float", "default": 3, "min": 1, "max": 10 }],
  "nodes": [
    { "id": "n1", "type": "PointCircle", "position": [120, 80], "params": { "count": 200 } },
    { "id": "out", "type": "OutputGeometry", "position": [600, 80], "label": "Result" }
  ],
  "links": [{ "from": ["n1", "points"], "to": ["out", "geometry"] }],
  "metaNodes": {
    "Petal": {
      "interface": {
        "inputs": [{ "name": "size", "type": "Vector" }],
        "outputs": [{ "name": "curve", "type": "Geometry" }]
      },
      "nodes": [{ "id": "p1", "type": "BezierCurve" }],
      "links": []
    }
  }
}
