{
  "name": "@vector-nodes/engine",
  "version": "0.0.0",
  "description": "Pull-based memoizing DAG interpreter for Vector Nodes.",
  "license": "Apache-2.0",
  "author": "Sergey Chernyshev <sergey.chernyshev@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergeychernyshev/vector-nodes.git",
    "directory": "packages/engine"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@vector-nodes/core": "*",
    "@vector-nodes/runtime": "*"
  }
}
